{
  "name": "nim-proxy",
  "version": "2.0.0",
  "description": "OpenAI-compatible proxy for NVIDIA NIM — chat, legacy completions, embeddings, images and audio with key rotation, SSE-safe streaming and observability",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "LOG_LEVEL=debug node --watch server.js",
    "test": "node --test test/",
    "test:ci": "node --test --test-reporter=spec test/",
    "test:sandboxed": "node --test --test-isolation=none --test-force-exit \"test/*.test.js\"",
    "audit": "npm audit --audit-level=high",
    "check": "node --check server.js && node --check shared.js"
  },
  "keywords": [
    "nvidia",
    "nim",
    "proxy",
    "openai",
    "chat-completions",
    "vercel",
    "alwaysdata"
  ],
  "author": "Dubucute",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dubucute/nim-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/Dubucute/nim-proxy/issues"
  },
  "homepage": "https://github.com/Dubucute/nim-proxy#readme",
  "dependencies": {
    "axios": "^1.21.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.3.0"
  }
}

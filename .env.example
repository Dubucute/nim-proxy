# ── NVIDIA NIM ───────────────────────────────────────────────────────────────
# Generate your own free key at https://build.nvidia.com/
# NEVER commit a real key. This file is .env.example — copy it to .env.
NIM_API_KEY=nvapi-your-key-here

# Optional: add more keys and they rotate automatically. On 429 the key is put
# on a jittered exponential cooldown (or whatever Retry-After asks for) and the
# next healthy key is used. Any name matching (NIM|NVIDIA)_API_KEY(_<n>) counts.
# NIM_API_KEY_2=nvapi-your-second-key
# NIM_API_KEY_3=nvapi-your-third-key

# Optional: base URL of the upstream completions API.
NIM_API_BASE=https://integrate.api.nvidia.com/v1

# ── Server ───────────────────────────────────────────────────────────────────
# alwaysdata and most PaaS hosts set PORT for you.
PORT=3000
HOST=0.0.0.0

# debug | info | warn | error   (LOG_JSON=true emits machine-readable lines)
LOG_LEVEL=info
# LOG_JSON=false

# Behind a reverse proxy / serverless platform this makes X-Forwarded-For and
# the rate limiter key on the real client instead of the load balancer.
# TRUST_PROXY=1

# ── Limits ───────────────────────────────────────────────────────────────────
# Maximum request body. 100mb was the old default; a chat request never needs
# more than a few megabytes.
BODY_LIMIT=10mb

# Per-client fixed-window limiter. 0 disables it entirely.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# ── Upstream behaviour ───────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=120000
# Abort a stream that produces no bytes for this long (stalled generation).
STREAM_IDLE_TIMEOUT_MS=120000
# Retries per request across keys for retryable upstream failures (429/5xx/network).
MAX_RETRIES=2
# Base cooldown after a rate limit; doubles per consecutive hit, capped at 5m.
KEY_COOLDOWN_MS=30000
UPSTREAM_MAX_SOCKETS=64

# ── CORS ─────────────────────────────────────────────────────────────────────
# '*' keeps today's behaviour (any website can call the proxy from a browser).
# Set a comma-separated allow-list to lock it to your own frontends:
# CORS_ORIGIN=https://yourapp.example,http://localhost:5173
CORS_ORIGIN=*

# ── Compatibility / features ─────────────────────────────────────────────────
# Accept a caller key from the JSON body (`apiKey`) as well as the Authorization
# header. Disable if you do not want requests choosing their own upstream key.
ALLOW_BODY_API_KEY=true

# ── Vision / image inlining ──────────────────────────────────────────────────
# NVIDIA's hosted gateway refuses to fetch external image URLs (it answers a bare
# 403), while the same bytes as a data URI work. With this on, the proxy downloads
# image_url parts and forwards them as data URIs so clients can keep sending URLs.
# WARNING: this makes the proxy an HTTP client for caller-supplied addresses.
# Private/loopback hosts are refused unless ALLOW_PRIVATE_IMAGE_HOSTS=true, and
# redirects are re-validated against the same rules. Prefer setting
# ALLOWED_IMAGE_HOSTS on anything reachable from outside your network.
INLINE_REMOTE_IMAGES=false
IMAGE_MAX_BYTES=8388608
IMAGE_TIMEOUT_MS=15000
ALLOW_PRIVATE_IMAGE_HOSTS=false
# ALLOWED_IMAGE_HOSTS=upload.wikimedia.org,cdn.example.com

# /logs dashboard and /api/logs. Set false to remove them from the build.
DASHBOARD_ENABLED=true
EXPOSE_INTERNAL_ENDPOINTS=true

# Model catalogue cache (NVIDIA's list changes rarely).
MODELS_CACHE_TTL_MS=900000
MODELS_STALE_GRACE_MS=86400000

# Ring buffer size for the request log.
REQUEST_LOG_SIZE=500

# ── VS Code integration (refresh_config.py) ──────────────────────────────────
# Where the generated chatLanguageModels.json should point.
# NIM_PROXY_URL=https://your-proxy.example
